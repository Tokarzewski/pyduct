<?xml version="1.0" encoding="utf-8"?>
<!--
  venti — ZWCAD .NET plugin scaffold (issue #13).

  Target: ZWCAD 2026+ (ZWCAD .NET API, source-compatible with AutoCAD .NET).
  Load the built Venti.Plugin.dll with the ZWCAD NETLOAD command, then run:
    VENTI, VENTI_SIZE.

  REQUIREMENTS
  - ZWCAD installed (managed API assembly ZwCAD.dll ships in the ZWCAD folder).
  - .NET Framework 4.8 targeting pack (comes with Visual Studio / Build Tools).
  - The venti WASM core staged next to the plugin (build-wasm + copy = #17).

  BUILD (on a machine with ZWCAD):
      msbuild Venti.Plugin.csproj /p:Configuration=Release /p:ZwCADHome="C:\Program Files\ZWSOFT\ZWCAD 2026"
  The ZWCAD reference is resolved from $(ZwCADHome)\ZwCAD.dll (override with /p:ZwCADHome=...).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Venti.Plugin</AssemblyName>
    <RootNamespace>Venti.Plugin</RootNamespace>
    <OutputType>Library</OutputType>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Resolve the ZWCAD managed API assembly from the install folder (override with /p:ZwCADHome). -->
  <PropertyGroup>
    <ZwCADHome Condition="'$(ZwCADHome)' == ''">C:\Program Files\ZWSOFT\ZWCAD 2026</ZwCADHome>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ZwCAD">
      <HintPath>$(ZwCADHome)\ZwCAD.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Stage the venti WASM core beside the plugin assembly (issue #17). -->
  <ItemGroup>
    <None Include="..\..\target\wasm32-wasip1\release\venti.wasm"
          Link="venti.wasm"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\target\wasm32-wasip1\release\venti.wasm')" />
  </ItemGroup>
</Project>

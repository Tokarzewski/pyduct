<?xml version="1.0" encoding="utf-8"?>
<!--
  Venti.Core — ZWCAD-independent bindings to the venti computational core
  (issue #18 testability split). Pure .NET: no ZWCAD reference, so the unit
  tests can P/Invoke the native lib / load the WASM without a CAD host.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>Venti.Core</RootNamespace>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- WASM backend (optional; disable with /p:UseWasm=false). -->
  <ItemGroup Condition="'$(UseWasm)' != 'false'">
    <PackageReference Include="Wasmtime" Version="0.38.0" />
  </ItemGroup>
</Project>

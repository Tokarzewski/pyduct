<?xml version="1.0" encoding="utf-8"?>
<!--
  Venti.Core.Tests — binding unit tests (issue #18). Targets any .NET and does
  NOT need ZWCAD; it exercises Venti.Core (NativeCore / WasmCore).

  Requirements to run:
    dotnet test
  - For NativeCore tests: build the venti cdylib (cargo build --release
    --no-default-features --lib) and place venti.dll / libventi.so /
    libventi.dylib on the DLL search path (e.g. alongside the test output, or
    VENTI_LIB_DIR). Tests that can't find a native lib skip the P/Invoke cases.
  - For WasmCore tests: venti.wasm next to the test output (scripts/build-wasm.sh).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Venti.Core\Venti.Core.csproj" />
  </ItemGroup>
  <!-- bring the native lib + wasm next to the tests if present -->
  <ItemGroup>
    <None Include="$(VENTI_LIB_DIR)/venti.dll" Link="venti.dll" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('$(VENTI_LIB_DIR)/venti.dll')" />
    <None Include="$(VENTI_LIB_DIR)/libventi.so" Link="libventi.so" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('$(VENTI_LIB_DIR)/libventi.so')" />
    <None Include="..\..\..\..\target\wasm32-wasip1\release\venti.wasm"
          Link="venti.wasm" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\..\..\target\wasm32-wasip1\release\venti.wasm')" />
  </ItemGroup>
</Project>
